{
    "schemaVersion": 1,
    "id": "${id}",
    "version": "${version}",
    "name": "${name}",
    "description": "${description}",
    "authors": ["${author}"],
    "contact": {
        "homepage": "${homepage}",
        "sources": "${sources}",
        "issues": "${issues}"
    },
    "license": "${license}",
    "icon": "${icon}",
    "environment": "server",
    "entrypoints": {
        "server": [
            {
                "value": "${entrypoint}"
            }
        ]
    },
    "mixins": [
        "${mixins}"
    ],
    "depends": {
        "fabricloader": "${fabricLoader}",
        "fabric": "${fabricApi}",
        "fabric-language-kotlin": "${fabricKotlin}",
        "minecraft": "${minecraft}"
    },
    "breaks": {
        "cardboard": "*"
    }
}
